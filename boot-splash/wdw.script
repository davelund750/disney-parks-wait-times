# Shows splash.png stretched to fill the screen for the whole boot.
# (Made for the Pi's 800x480 touchscreen; other sizes just get it scaled.)
Window.SetBackgroundTopColor(0.05, 0.07, 0.09);
Window.SetBackgroundBottomColor(0.05, 0.07, 0.09);

splash = Image("splash.png");
splash_sprite = Sprite(splash.Scale(Window.GetWidth(), Window.GetHeight()));
splash_sprite.SetPosition(Window.GetX(), Window.GetY(), 0);
